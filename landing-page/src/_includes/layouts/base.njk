<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.title }} — {{ site.tagline }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.title }} — {{ site.tagline }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.title }} — {{ site.tagline }}">
  <meta name="twitter:description" content="{{ description or site.description }}">

  <!-- Fonts: Outfit (display), JetBrains Mono (technical), Source Serif 4 (body quotes) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;1,400&display=swap" rel="stylesheet">

  <!-- Critical CSS inlined for faster First Contentful Paint -->
  <style>
    /* Critical reset and base styles */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; scroll-behavior: smooth; }
    body {
      font-family: 'Outfit', system-ui, sans-serif;
      background-color: #0a0c0f;
      color: #e8e6e3;
      min-height: 100vh;
    }
    /* Skip link - visible on focus */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 50%;
      transform: translateX(-50%);
      background: #d97706;
      color: #0a0c0f;
      padding: 0.75rem 1.5rem;
      border-radius: 0 0 0.5rem 0.5rem;
      font-weight: 600;
      z-index: 9999;
      transition: top 0.2s;
    }
    .skip-link:focus {
      top: 0;
      outline: 2px solid #f59e0b;
      outline-offset: 2px;
    }
    /* Header skeleton to prevent layout shift */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1.5rem 0;
    }
  </style>

  <!-- Main stylesheet with preload for faster loading -->
  <link rel="preload" href="/assets/css/main.css" as="style">
  <link rel="stylesheet" href="/assets/css/main.css">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏭</text></svg>">
</head>
<body>
  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Blueprint grid overlay -->
  <div class="grid-overlay" aria-hidden="true"></div>

  {% include "partials/header.njk" %}

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script type="module" src="/assets/js/main.js"></script>
</body>
</html>
