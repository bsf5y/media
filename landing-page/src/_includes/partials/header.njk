<header class="site-header">
  <div class="container">
    <a href="/" class="logo">
      <span class="logo-mark">BSF5Y</span>
      <span class="logo-text">{{ site.title }}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {% for item in site.nav %}
        {% if item.class %}
          <a href="{{ item.url }}" class="{{ item.class }}">{{ item.text }}</a>
        {% elif item.isButton %}
          <button class="{{ item.buttonClass }}" aria-label="{{ item.ariaLabel }}" title="{{ item.title }}">
            {{ item.text | safe }}
          </button>
        {% else %}
          <a href="{{ item.url }}">{{ item.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</header>
