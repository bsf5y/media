{
  "name": "@bsf5y/slidev-theme",
  "version": "0.0.1",
  "description": "Refined Industrial Blueprint theme for Slidev — port of The Bootstrap Factory's design system.",
  "author": "The Bootstrap Factory",
  "license": "MIT",
  "homepage": "https://github.com/bsf5y/media/tree/dev/slidev-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsf5y/media.git",
    "directory": "slidev-theme"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "global-bottom.vue",
    "README.md"
  ],
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev",
    "bsf5y",
    "bootstrap-factory",
    "blueprint"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.15.2"
  },
  "devDependencies": {
    "@slidev/cli": "^52.15.2"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki",
    "defaults": {
      "fonts": {
        "sans": "Outfit",
        "serif": "Source Serif 4",
        "mono": "JetBrains Mono",
        "weights": "400,500,600,700,800",
        "italic": true
      }
    }
  }
}
